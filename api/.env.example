# Server
PORT=

# Database
# Application user: used by the API at runtime. After `npm run db:harden` it can only
# read/write data, and can only SELECT/INSERT on audit_events.
DATABASE_URL=
# MySQL admin (e.g. root): only used by `npm run db:migrate` and `npm run db:harden`.
DATABASE_ADMIN_URL=

# Swagger API Documentation
SWAGGER_ENABLED=
SWAGGER_PROTECTED=
SWAGGER_USER=
SWAGGER_PASSWORD=

# Initial Platform Administrator
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# Authentication (#13)
# Secret used to sign access tokens. REQUIRED in production; long random value (e.g. 64 hex chars).
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=
# Session (refresh token) lifetime in days, counted from login; refreshing does not extend it (default 30)
JWT_REFRESH_TTL_DAYS=
# Expired/revoked sessions older than this many days are deleted by the daily cleanup (default 30)
SESSION_RETENTION_DAYS=
# true = enable the DEV-ONLY /auth/dev/* routes (token for any user, demo fixtures). Never in production.
AUTH_DEV_TOOLS=

# Audit trail
# true = enable the DEV-ONLY /audit/dev/* routes that simulate auth events (never in production)
AUDIT_DEV_TOOLS=
