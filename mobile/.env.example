# Orvia Mobile Environment Configuration
# Copy this file to .env.local (ignored by git) for local overrides.

# Base URL of the Orvia NestJS API (defaults to Metro host on port 8084, or http://localhost:8084)
EXPO_PUBLIC_API_URL=http://localhost:8084

# Optional DEV-ONLY settings (requires AUTH_DEV_TOOLS=true on the API)
# EXPO_PUBLIC_DEV_EMAIL=student.a@demo.test
# EXPO_PUBLIC_ACCESS_TOKEN=
